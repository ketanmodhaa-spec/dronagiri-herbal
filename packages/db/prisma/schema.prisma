// Dronagiri Herbal — data model
// ──────────────────────────────────────────────────────────────────────────
// Conventions
//   • Money: every *Paise field is an integer in paise (₹299 = 29900). No floats.
//   • IDs: cuid(). Human-facing identifiers (orderNumber, trackingToken) are
//     separate unique strings generated in application code.
//   • Deletes: products, categories and coupons are soft-deleted via isActive —
//     relations that hold history use onDelete: Restrict to enforce that.
//   • Not modelled here (deliberate): the cart (Redis), OTP challenges (Redis),
//     and guest sessions (stateless JWT). See packages/db notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING // created, awaiting online payment or COD confirmation
  CONFIRMED // paid online, or COD accepted — stock committed
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_INITIATED // admin started the refund — awaiting Razorpay webhook confirmation
  REFUNDED // Razorpay webhook confirmed the refund completed
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE // Razorpay — UPI / card / netbanking
  COD
}

enum StockMovementReason {
  SALE // order confirmed — stock leaves
  RESTOCK // Sarita's WhatsApp RESTOCK command
  ADJUSTMENT // manual correction by admin
  RETURN // customer return — stock re-enters
  CANCELLATION // confirmed order cancelled — stock restored
  REPLACEMENT // replacement goods sent free for a damaged / wrong item
}

enum StockMovementSource {
  WHATSAPP_CMD // Sarita's RESTOCK command via WhatsApp
  ADMIN_PANEL // manual change in the admin panel
  ORDER // automatic — driven by an order's lifecycle
  WEBHOOK // automatic — driven by an inbound webhook (e.g. payment)
  SYSTEM // automatic — seed, migration, or cron; no human or external trigger
}

enum RefundMethod {
  RAZORPAY // back to the original online payment, through Razorpay
  MANUAL // paid by Sarita outside the system (UPI / bank transfer) — COD orders
}

enum RefundStatus {
  PENDING // asked for — Razorpay has not confirmed it yet
  PROCESSED // the money has left
  FAILED // Razorpay refused or failed it — nothing was refunded
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum AdminRole {
  OWNER // Sarita
  STAFF
}

enum CouponType {
  PERCENT // value = percentage points; maxDiscountPaise caps the discount
  FLAT // value = paise off
}

enum AbcClass {
  A
  B
  C
}

// ──────────────────────────────────────────────────────────────────────────
// Catalog
// ──────────────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameGu      String?
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Product sensory profile ────────────────────────────────────────────────

enum ProductTexture {
  LIGHTWEIGHT_GEL
  RICH_BODY_BUTTER
  NOURISHING_OIL
  NON_GREASY_LOTION
  REFRESHING_MIST
  FOAMING_SHAMPOO
  POWDER_PACK // mixed into a paste before use
  EXFOLIATING_SCRUB
}

enum ProductAroma {
  HERBAL
  EARTHY
  FLORAL
  CITRUS
  CAMPHOR
  WARM // coffee, turmeric, spices
  MILD_NATURAL // no added fragrance — smells of its ingredients
}

// Skin and hair finishes share one enum: some products (aloe vera gel,
// coconut oil) are used on both, so the category can't decide the list.
enum ProductFinish {
  SKIN_MATTE
  SKIN_DEWY
  SKIN_NOURISHING
  SKIN_FRESH
  HAIR_SOFT_SMOOTH
  HAIR_VOLUMINOUS
  HAIR_CONDITIONED
  HAIR_CLEAN_FRESH
}

enum ProductRoutine {
  LEAVE_ON
  RINSE_OFF
}

model Product {
  id        String  @id @default(cuid())
  slug      String  @unique
  sku       String  @unique
  name      String
  nameGu    String?
  tagline   String?
  taglineGu String?

  // Long-form content — rendered as accordions on the product page.
  // English is required; Gujarati is filled in over time by the admin.
  description   String  @db.Text
  descriptionGu String? @db.Text
  benefits      String? @db.Text
  benefitsGu    String? @db.Text
  ingredients   String? @db.Text
  ingredientsGu String? @db.Text
  howToUse      String? @db.Text
  howToUseGu    String? @db.Text

  // Pricing — paise, integer
  pricePaise   Int
  comparePaise Int? // MRP / strike-through price

  // Inventory — stockQty is the materialised balance of the StockMovement ledger
  stockQty          Int @default(0)
  lowStockThreshold Int @default(10)

  // Sensory profile — fixed choices shown as "How it feels" on the product
  // page, so every product is described in the same words. All optional; a
  // row that isn't set simply isn't shown.
  texture       ProductTexture?
  aromas        ProductAroma[]  @default([])
  finish        ProductFinish?
  routine       ProductRoutine?
  routineNote   String? // e.g. "2 hrs on hair · shampoo after 24 hrs"
  routineNoteGu String?

  // Logistics & display
  weightGrams Int?
  sizeLabel   String? // e.g. "100 ml", "200 g"

  // Merchandising
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)

  // Intelligence — set by the analytics aggregation cron
  abcClass AbcClass?

  images     ProductImage[]
  aliases    ProductAlias[]
  orderItems OrderItem[]
  movements  StockMovement[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // Cloudflare R2 object URL
  alt       String?
  altGu     String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0) // lowest sortOrder is the hero image
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductAlias {
  id        String   @id @default(cuid())
  alias     String   @unique // lowercase short code for WhatsApp restock, e.g. "hpp"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true) // soft-disable an alias without deleting it
  createdAt DateTime @default(now())

  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────
// Customers
// ──────────────────────────────────────────────────────────────────────────

model Customer {
  id                   String    @id @default(cuid())
  phone                String    @unique // E.164 — the primary customer identity
  name                 String?
  email                String? // always optional, never required
  // Marketing consent (DPDP Act, Meta WhatsApp policy): off unless the
  // customer actively ticks the box. The time and the exact wording shown are
  // kept as proof; a WhatsApp "STOP" turns it off again.
  marketingConsent     Boolean   @default(false)
  marketingConsentAt   DateTime?
  marketingConsentText String?
  marketingOptOutAt    DateTime?
  lastOrderAt          DateTime? // drives win-back nudges
  addresses            Address[]
  orders               Order[]
  reviews              Review[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([lastOrderAt])
}

model Address {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String? // "Home", "Work"
  recipientName String
  phone         String
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  pincode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

// ──────────────────────────────────────────────────────────────────────────
// Orders
// ──────────────────────────────────────────────────────────────────────────

model Order {
  id                String  @id @default(cuid())
  orderNumber       String  @unique // human-facing, e.g. "DH-26-00042"
  trackingTokenHash String  @unique // SHA-256 of the tracking token; raw token is sent to the customer and never stored
  idempotencyKey    String? @unique // guards against duplicate checkout submits

  // Set when the order needs Sarita before it can move on (paid but out of
  // stock, a second payment, a failed refund). Null = nothing to do.
  attentionReason String?

  // A replacement is a free order sent for a damaged / wrong item in another.
  replacementForId String?
  replacementFor   Order?  @relation("Replacement", fields: [replacementForId], references: [id], onDelete: Restrict)
  replacements     Order[] @relation("Replacement")

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PENDING)

  // Shipping address — snapshot, immutable once the order is placed
  shipRecipientName String
  shipPhone         String
  shipLine1         String
  shipLine2         String?
  shipLandmark      String?
  shipCity          String
  shipState         String
  shipPincode       String

  // Pricing — paise, integer.  totalPaise = subtotalPaise - discountPaise + shippingPaise
  subtotalPaise Int
  discountPaise Int @default(0)
  shippingPaise Int @default(0)
  totalPaise    Int

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)

  // Payment
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?

  // Fulfillment
  courierName    String?
  trackingNumber String?

  customerNote String?
  internalNote String?

  // Surprise sample for loyal customers — the system suggests, the packer
  // records what went into the parcel.
  sampleAddedAt DateTime?
  sampleNote    String?

  // Lifecycle timestamps
  paidAt      DateTime?
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?

  items     OrderItem[]
  events    OrderEvent[]
  movements StockMovement[]
  refunds   Refund[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([couponId])
  @@index([createdAt])
  @@index([replacementForId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshots — frozen at order time so historical orders never shift
  productName    String
  productSlug    String
  unitPricePaise Int // server-verified price at the time of order
  quantity       Int
  lineTotalPaise Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy String? // admin id, or "system" for automatic changes
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// Money returned to a customer. An order can have several (partial refunds);
// processed + pending refunds never exceed what was paid.
model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amountPaise Int
  method      RefundMethod
  status      RefundStatus @default(PENDING)
  reason      String

  razorpayRefundId String? @unique
  manualReference  String? // UPI / bank transfer reference for MANUAL refunds
  failureReason    String?
  idempotencyKey   String  @unique // the admin form's key — a double tap refunds once

  createdBy   String // admin id
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// Inventory ledger
// ──────────────────────────────────────────────────────────────────────────

model StockMovement {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  delta        Int // signed: negative = stock out, positive = stock in
  balanceAfter Int // Product.stockQty immediately after this movement
  reason       StockMovementReason
  orderId      String?
  order        Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  source       StockMovementSource // which surface triggered this movement
  createdBy    String? // the actor: admin id, "system", or Sarita's phone hash
  note         String?
  createdAt    DateTime            @default(now())

  @@index([productId])
  @@index([orderId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Coupons
// ──────────────────────────────────────────────────────────────────────────

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique // uppercase, e.g. "WELCOME10"
  description      String?
  type             CouponType
  value            Int // PERCENT: percentage points;  FLAT: paise off
  maxDiscountPaise Int? // cap for PERCENT coupons
  minOrderPaise    Int        @default(0)
  usageLimit       Int? // null = unlimited
  usedCount        Int        @default(0)
  perCustomerLimit Int?
  validFrom        DateTime?
  validUntil       DateTime?
  isActive         Boolean    @default(true)
  orders           Order[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ──────────────────────────────────────────────────────────────────────────
// Admin
// ──────────────────────────────────────────────────────────────────────────

model AdminUser {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String // bcrypt
  name          String
  role          AdminRole           @default(STAFF)
  isActive      Boolean             @default(true)
  lastLoginAt   DateTime?
  refreshTokens AdminRefreshToken[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model AdminRefreshToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique // SHA-256 of the refresh token — raw token is never stored
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Notifications & analytics
// ──────────────────────────────────────────────────────────────────────────

// Append-only log of every notification attempt. Order fulfillment never
// blocks on this. orderId / customerId are kept as loose references so the
// log outlives the records it points at and never blocks a delete.
model NotificationLog {
  id                String              @id @default(cuid())
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  recipient         String // phone number or email address
  templateName      String?
  payload           Json?
  providerMessageId String?
  errorMessage      String?
  orderId           String?
  customerId        String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// Append-only behavioural event stream that feeds the intelligence layer.
// phoneHash is a SHA-256 of the phone number — plaintext phone is never
// stored here (security rule 7).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  phoneHash String?
  sessionId String?
  productId String?
  orderId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([phoneHash])
  @@index([productId])
}

// ─── B2B partner enquiries ──────────────────────────────────────────────────

enum PartnerType {
  DISTRIBUTOR // district / state distributor
  STOCKIST // holds stock for an area, supplies retailers
  RETAILER // shop, pharmacy, salon or parlour selling to consumers
  SALES_AGENT // local sales person / representative
}

enum PartnerBackground {
  NEW_TO_BUSINESS
  RETAIL_SHOP
  FMCG_DISTRIBUTION
  AYURVEDA_OR_COSMETICS
  SALON_OR_PARLOUR
  OTHER
}

enum PartnerInvestment {
  UNDER_50K
  FROM_50K_TO_2L
  FROM_2L_TO_5L
  ABOVE_5L
}

enum PartnerEnquiryStatus {
  NEW // not yet contacted
  CONTACTED // first call / WhatsApp done
  IN_DISCUSSION // terms, territory or first order being discussed
  APPOINTED // now a partner
  NOT_SUITABLE // closed without appointment
}

// "Become a distributor / dealer" form submissions — a lead list Sarita works
// through from the admin panel. Phone is stored in plaintext because the whole
// point is to call the person back; it never feeds analytics.
model PartnerEnquiry {
  id           String             @id @default(cuid())
  partnerType  PartnerType
  name         String
  phone        String // 10-digit Indian mobile, as entered
  email        String?
  businessName String?
  city         String
  stateCode    String // GST state code, e.g. "10" Bihar, "08" Rajasthan
  pincode      String?
  gstin        String?
  background   PartnerBackground?
  investment   PartnerInvestment?
  message      String?

  status       PartnerEnquiryStatus @default(NEW)
  internalNote String? // Sarita's notes — never shown to the enquirer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([stateCode])
}

// ─── Order numbering ────────────────────────────────────────────────────────

// One row per calendar year (IST); `lastNumber` is the last order number
// issued that year. Incremented atomically with INSERT … ON CONFLICT, so two
// orders can never get the same number. Order numbers read DH-26-00042.
model OrderNumberCounter {
  year       Int @id
  lastNumber Int
}

// ─── Reviews ────────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING // submitted — waiting for Sarita to check it against the posting rules
  PUBLISHED // visible on the product page
  REJECTED // broke a posting rule — never for being negative
}

// Why a review was not published. Deliberately has no "negative" option:
// honest bad reviews are published (Consumer Protection (E-Commerce) Rules,
// BIS IS 19000:2022 on online consumer reviews).
enum ReviewRejectReason {
  ABUSIVE // abusive, hateful or obscene language
  PERSONAL_INFO // phone numbers, addresses or other personal data
  MEDICAL_CLAIM // claims to cure or treat a disease — cannot appear on a cosmetics site
  SPAM // advertising, links, gibberish
  NOT_ABOUT_PRODUCT // about delivery or something else entirely — handled privately
}

// A review by a verified buyer: only reachable through the signed link for a
// delivered order, one per product per order.
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  rating      Int // 1–5
  title       String?
  body        String
  displayName String // e.g. "Priya S." — chosen by the reviewer
  city        String? // from the order's ship-to

  status       ReviewStatus        @default(PENDING)
  rejectReason ReviewRejectReason?
  moderatedBy  String? // admin id
  moderatedAt  DateTime?

  ownerReply   String? // Sarita's public reply
  ownerReplyAt DateTime?

  helpfulCount Int          @default(0) // materialised count of ReviewVote rows
  votes        ReviewVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId, status])
  @@index([status])
}

// One "helpful" thumbs-up per visitor per review. voterKey is a SHA-256 of
// the guest session id — no personal data.
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  voterKey  String
  createdAt DateTime @default(now())

  @@unique([reviewId, voterKey])
}
